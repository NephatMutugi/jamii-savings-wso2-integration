{
  "rabbit_version": "3.13.0",
  "vhosts": [{ "name": "/" }],
  "exchanges": [
    {
      "name": "jamii.loans",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "jamii.loans.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
