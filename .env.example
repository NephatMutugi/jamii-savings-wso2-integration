# Copy to .env and change every value before bringing up the stack.
# .env is gitignored; only this template is committed.

JAMII_DB_ROOT_PASSWORD=change-me-root
# Must match the database in JAMII_DB_URL below: MySQL grants JAMII_DB_USER
# privileges only on JAMII_DB_NAME, so a mismatch means "access denied".
JAMII_DB_NAME=jamii
JAMII_DB_USER=jamii_app
JAMII_DB_PASSWORD=change-me-app
# No query parameters, and in particular no "&": MI's config mapper writes
# this value into conf/datasources/master-datasources.xml without escaping
# it, so an ampersand makes that file invalid XML and every datasource
# silently disappears. Connector/J 9.x needs neither serverTimezone (the
# server's timezone is pinned in docker-compose.yml) nor useSSL=false
# (sslMode defaults to PREFERRED, which satisfies caching_sha2_password).
JAMII_DB_URL=jdbc:mysql://db:3306/jamii

# The 1b customer backend URL is NOT set here. MI's ${configs.x} resolver does
# not read the process environment, so the URL is literal in
# mi/src/main/wso2mi/artifacts/endpoints/CustomerBackendEP.xml. To point it at
# the WireMock stub for the timeout and outage demos, edit that file and
# rebuild. The README explains why.

MI_ADMIN_USER=admin
MI_ADMIN_PASSWORD=change-me-mi

APIM_ADMIN_USER=admin
APIM_ADMIN_PASSWORD=change-me-apim
