<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="DashboardProfileEP" xmlns="http://ws.apache.org/ns/synapse">
    <!-- The dashboard composes the existing APIs rather than re-implementing
         their backend calls, so masking, validation and error mapping stay in
         one place per backend. Cost: one in-process HTTP hop per section.

         Timeout is deliberately shorter than CustomersAPI's own 3 s backend
         timeout, so a slow upstream shows up here as a missing section rather
         than stalling the whole dashboard. -->
    <http method="get"
          uri-template="http://localhost:8290/customers/{uri.var.customerId}">
        <timeout>
            <duration>2500</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <errorCodes>-1</errorCodes>
            <initialDuration>0</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>0</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <errorCodes>-1</errorCodes>
        </markForSuspension>
    </http>
</endpoint>
