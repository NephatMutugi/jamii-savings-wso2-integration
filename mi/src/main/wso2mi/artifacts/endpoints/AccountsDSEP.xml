<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="AccountsDSEP" xmlns="http://ws.apache.org/ns/synapse">
    <http method="get"
          uri-template="http://localhost:8290/services/AccountsDS/accounts/{uri.var.accountNumber}">
        <timeout>
            <duration>5000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <!-- Suspension disabled on purpose: a DB outage must not leave the
             endpoint suspended once MySQL is back, which would make every
             later call fail for reasons unrelated to the request. A
             production deployment would suspend; noted in the README. -->
        <suspendOnFailure>
            <errorCodes>-1</errorCodes>
            <initialDuration>0</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>0</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <errorCodes>-1</errorCodes>
        </markForSuspension>
    </http>
</endpoint>
