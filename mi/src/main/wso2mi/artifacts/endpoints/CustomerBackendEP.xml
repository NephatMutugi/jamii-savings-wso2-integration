<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="CustomerBackendEP" xmlns="http://ws.apache.org/ns/synapse">
    <!-- Literal backend URL, in the same <http> form as AccountsDSEP.
         Externalising it was attempted with ${configs.CUSTOMER_BACKEND_URL}
         and abandoned: the resolver reads a config file named by the server's
         env-file startup flag, not the process environment, and overriding
         the stock image's entrypoint is not worth the demo convenience.
         See the README for the full reasoning.

         To demonstrate the timeout and outage paths, point this at the stub
         and rebuild (about 40 seconds):
             uri-template="https://dummyjson.com/users/{uri.var.customerId}"
         then `mvn -B clean install -q && cp mi/target/*.car deploy/carbonapps/`. -->
    <http method="get"
          uri-template="https://dummyjson.com/users/{uri.var.customerId}">
        <timeout>
            <duration>3000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <!-- Suspension disabled for the same reason as AccountsDSEP: one slow
             or failed call must not make every later call fail. Production
             would suspend; noted in the README. -->
        <suspendOnFailure>
            <errorCodes>-1</errorCodes>
            <initialDuration>0</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>0</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <errorCodes>-1</errorCodes>
        </markForSuspension>
    </http>
</endpoint>
