<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Common_InFlow" xmlns="http://ws.apache.org/ns/synapse">
    <!-- Reuse the caller's correlation ID only when it is well formed.
         Rejecting malformed IDs keeps attacker-controlled text out of logs. -->
    <filter source="$trp:X-Correlation-ID" regex="^[A-Za-z0-9-]{8,64}$">
        <then>
            <property name="requestId" expression="$trp:X-Correlation-ID"/>
        </then>
        <else>
            <!-- VERIFY: MessageID is "urn:uuid:<uuid>" on MI 4.6.0 -->
            <property name="requestId"
                      expression="fn:substring-after(get-property('MessageID'), 'urn:uuid:')"/>
        </else>
    </filter>
    <header name="X-Correlation-ID" scope="transport" expression="$ctx:requestId"/>
    <!-- Drop the caller's content-negotiation headers so they are not
         forwarded upstream. A client sending "Accept-Encoding: gzip, deflate,
         br" otherwise makes the backend return a compressed body, which MI
         then fails to parse with
         "601000 Error while building message. Error while building Passthrough stream".
         Postman and most HTTP clients send this by default; curl does not,
         which is why it stayed hidden until the contract tests ran. -->
    <header name="Accept-Encoding" scope="transport" action="remove"/>
    <!-- The request path is deliberately not logged: it carries the account
         or customer identifier. Each API logs its own masked copy instead. -->
    <log level="custom" category="INFO">
        <property name="event" value="REQUEST_IN"/>
        <property name="requestId" expression="$ctx:requestId"/>
        <property name="api" expression="$ctx:SYNAPSE_REST_API"/>
        <property name="method" expression="$axis2:HTTP_METHOD"/>
    </log>
</sequence>
