<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Common_Fault" xmlns="http://ws.apache.org/ns/synapse">
    <!-- The Synapse error detail is logged here and never returned, so
         backend hostnames, SQL and stack traces cannot reach a client. -->
    <log level="custom" category="ERROR">
        <property name="event" value="FAULT"/>
        <property name="requestId" expression="$ctx:requestId"/>
        <property name="synapseErrorCode" expression="$ctx:ERROR_CODE"/>
        <property name="synapseErrorMessage" expression="$ctx:ERROR_MESSAGE"/>
    </log>
    <!-- Classify only when the API has not already set a contract code.
         Written as not(...) with a single <then>: Synapse refuses to deploy a
         filter that supplies <else> without <then>. -->
    <filter xpath="not(boolean($ctx:ERR_CODE))">
        <then>
            <switch source="$ctx:ERROR_CODE">
                <case regex="101504">
                    <property name="ERR_HTTP" value="504"/>
                    <property name="ERR_CODE" value="BACKEND_TIMEOUT"/>
                    <property name="ERR_MSG" value="The upstream service did not respond in time"/>
                </case>
                <case regex="101503|101500|101501|101506|101507|101508|303001">
                    <property name="ERR_HTTP" value="503"/>
                    <property name="ERR_CODE" value="BACKEND_UNAVAILABLE"/>
                    <property name="ERR_MSG" value="The upstream service is unavailable"/>
                </case>
                <case regex="101505">
                    <property name="ERR_HTTP" value="502"/>
                    <property name="ERR_CODE" value="BACKEND_ERROR"/>
                    <property name="ERR_MSG" value="The upstream service returned an invalid response"/>
                </case>
                <!-- 601000 is a message-building failure. When it happens
                     after a backend call it means the response could not be
                     parsed, which is a backend problem and not the caller's
                     fault, so it must not be reported as 400. -->
                <case regex="601000">
                    <property name="ERR_HTTP" value="502"/>
                    <property name="ERR_CODE" value="BACKEND_ERROR"/>
                    <property name="ERR_MSG" value="The upstream service returned an unreadable response"/>
                </case>
                <default>
                    <property name="ERR_HTTP" value="500"/>
                    <property name="ERR_CODE" value="INTERNAL_ERROR"/>
                    <property name="ERR_MSG" value="An unexpected error occurred"/>
                </default>
            </switch>
            <!-- Deliberately does NOT match the bare word "building". It used
                 to, and that turned every unreadable backend response into a
                 400, telling callers their request was malformed when the
                 real fault was upstream. Only JSON-parse specific wording
                 counts as a client error. -->
            <filter source="$ctx:ERROR_MESSAGE"
                    regex="(?s).*(JsonParse|Unexpected character|Malformed JSON|Invalid JSON).*">
                <then>
                    <property name="ERR_HTTP" value="400"/>
                    <property name="ERR_CODE" value="INVALID_REQUEST"/>
                    <property name="ERR_MSG" value="The request body is not valid JSON"/>
                </then>
            </filter>
        </then>
    </filter>
    <sequence key="Common_ErrorBuilder"/>
</sequence>
